        proc_reversed = false;
        proc_gradient = true;
      };
    };

    bat = {
      enable = true;
      extraPackages = with pkgs.bat-extras; [ batdiff batman batgrep batwatch ];
    };

    ssh = {
      enable = true;
      extraOptionOverrides = {
        SetEnv = "TERM=xterm-256color";
      };
      matchBlocks."172.16.2.72" = {
        forwardX11Trusted = true;
        forwardX11 = true;
      };

      };

    fzf = {
      enable = true;
      defaultCommand = "fd --type f";
    };

  };
}

