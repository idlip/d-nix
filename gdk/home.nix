      extraConfig = {
        xdg_screenshots_dir = "${config.xdg.userDirs.pictures}/sshots";
      };
    };

  };
  xdg.dataFile."applications/d-stuff.desktop".text = ''
  [Desktop Entry]
  Type=Application
  Name=Stuff Handler
  Exec=d-stuff %u
  '';

